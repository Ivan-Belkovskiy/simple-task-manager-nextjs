generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}


enum AccountAccessLevel {
  USER
  MANAGER
}

enum AccountTokenType {
  TELEGRAM_LINK
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum TaskItemKind {
  ITEM        
  ACTION      
  REQUIREMENT 
}

enum NotificationFormat {
  POPUP       
  MODAL       
  FULLSCREEN  
}

enum NotificationPlatform {
  WEB
  DESKTOP
  MOBILE
}


model app_accounts {
  id String @id @default(uuid(7)) @db.Uuid

  username      String @unique @db.VarChar(80)
  login         String @unique @db.VarChar(100)
  password_hash String @db.VarChar(300)

  email             String?   @unique @db.VarChar(200)
  email_verified_at DateTime? @db.Timestamptz(6)

  telegram_id          String?   @unique @db.VarChar(50)
  telegram_username    String?   @db.VarChar(100)
  telegram_verified_at DateTime? @db.Timestamptz(6)

  notify_via_web      Boolean @default(true)
  notify_via_email    Boolean @default(false)
  notify_via_telegram Boolean @default(false)

  access_level AccountAccessLevel @default(USER)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  tasks            tasks[]
  task_categories  task_categories[]
  user_records     users[]
  sessions         sessions[]
  account_tokens   account_tokens[]
}

model sessions {
  id           String   @id @default(uuid(7)) @db.Uuid
  user_id      String   @db.Uuid
  refresh_hash String   @db.VarChar(300)
  user_agent   String?  @db.VarChar(300)
  ip           String?  @db.VarChar(45)
  last_active  DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  user app_accounts @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model account_tokens {
  id         String           @id @default(uuid(7)) @db.Uuid
  account_id String           @db.Uuid
  type       AccountTokenType
  token_hash String           @unique
  expires_at DateTime         @db.Timestamptz(6)
  used_at    DateTime?        @db.Timestamptz(6)
  created_at DateTime         @default(now()) @db.Timestamptz(6)

  account app_accounts @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id, type])
  @@index([expires_at])
}


model task_categories {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(140)
  account_id String  @db.Uuid

  account app_accounts @relation(fields: [account_id], references: [id], onDelete: Cascade)
  tasks   tasks[]

  @@unique([account_id, name])
  @@index([account_id])
}

model task_priorities {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(50)
  weight        Int     @unique
  display_color String? @db.VarChar(9)
  tasks         tasks[]
}

model users {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(160)
  account_id String  @db.Uuid

  account    app_accounts @relation(fields: [account_id], references: [id], onDelete: Cascade)
  task_users task_users[]

  @@index([account_id])
}

model task_users {
  task_id Int
  user_id Int

  tasks tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([task_id, user_id])
}

model tasks {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(200)
  description          String?
  priority_id          Int?
  category_id          Int?
  completed            Boolean   @default(false)
  rejected             Boolean   @default(false)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  completed_at         DateTime? @db.Timestamptz(6)
  complete_before_date DateTime? @db.Timestamptz(6)
  complete_info        String?
  account_id           String    @db.Uuid

  account     app_accounts @relation(fields: [account_id], references: [id], onDelete: Cascade)
  category    task_categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  priority    task_priorities? @relation(fields: [priority_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subtasks           subtasks[]
  task_notifications task_notifications[]
  task_users         task_users[]
  items              task_items[]

  dependencies task_dependencies[] @relation("TaskDependencies")
  dependents   task_dependencies[] @relation("TaskDependents")

  @@index([account_id])
  @@index([account_id, completed, rejected])
  @@index([account_id, complete_before_date])
  @@index([category_id])
  @@index([priority_id])
}

model subtasks {
  id           Int       @id @default(autoincrement())
  task_id      Int
  name         String    @db.VarChar(210)
  description  String?
  order        Int       @default(0)
  completed    Boolean   @default(false)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)

  task tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id])
  @@index([task_id, order])
}

model task_items {
  id           Int          @id @default(autoincrement())
  task_id      Int
  kind         TaskItemKind @default(ACTION)
  name         String       @db.VarChar(210)
  description  String?
  quantity     String?      @db.VarChar(50)
  order        Int          @default(0)
  completed    Boolean      @default(false)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  completed_at DateTime?    @db.Timestamptz(6)

  task tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id])
  @@index([task_id, kind, order])
}

model task_dependencies {
  task_id       Int
  depends_on_id Int
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  task       tasks @relation("TaskDependencies", fields: [task_id],       references: [id], onDelete: Cascade)
  depends_on tasks @relation("TaskDependents",   fields: [depends_on_id], references: [id], onDelete: Cascade)

  @@id([task_id, depends_on_id])
  @@index([depends_on_id])
}

model task_notifications {
  id          Int     @id @default(autoincrement())
  task_id     Int?
  hour_offset Int?
  activated   Boolean @default(false)

  target_platforms NotificationPlatform[] @default([WEB])
  display_format   NotificationFormat     @default(POPUP)
  ringtone         String?                @db.VarChar(100)

  task tasks? @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id])
  @@index([activated])
}