generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model task_categories {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(140)
  tasks tasks[]

  account_id String? @db.Uuid
  appAccounts app_accounts? @relation(fields: [account_id], references: [id])
}

model task_priorities {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(50)
  weight        Int     @unique
  display_color String? @db.VarChar(9)
  tasks         tasks[]
}

model task_users {
  task_id Int
  user_id Int
  tasks   tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([task_id, user_id])
}

model tasks {
  id                   Int                  @id @default(autoincrement())
  name                 String               @db.VarChar(200)
  description          String?
  priority_id          Int?
  category_id          Int?
  completed            Boolean
  created_at           DateTime?            @default(now()) @db.Timestamptz(6)
  completed_at         DateTime?            @db.Timestamptz(6)
  complete_before_date DateTime?            @db.Timestamptz(6)
  rejected             Boolean              @default(false)
  complete_info        String?
  subtasks             subtasks[]
  task_notifications   task_notifications[]
  task_users           task_users[]
  task_categories      task_categories?     @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  task_priorities      task_priorities?     @relation(fields: [priority_id], references: [id], onDelete: NoAction, onUpdate: NoAction)


  account_id String? @db.Uuid
  appAccounts app_accounts? @relation(fields: [account_id], references: [id])
}

model users {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(160)

  account_id String? @db.Uuid

  task_users task_users[]

  appAccounts app_accounts? @relation(fields: [account_id], references: [id])
}

model task_notifications {
  id          Int     @id @default(autoincrement())
  task_id     Int?
  hour_offset Int?
  activated   Boolean @default(false)
  tasks       tasks?  @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model subtasks {
  id           Int       @id @default(autoincrement())
  task_id      Int?
  name         String    @db.VarChar(210)
  description  String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  completed    Boolean?
  tasks        tasks?    @relation(fields: [task_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "subtasks_tasks_fkey")

  @@index([task_id], map: "subtasks_task_id_fkey")
}

// This table for REAL profiles and accounts:

enum AccountAccessLevel {
  USER
  MANAGER
}

model app_accounts {
  id String @id @default(uuid(7)) @db.Uuid

  username      String @unique @db.VarChar(80)
  login         String @unique @db.VarChar(100)
  password_hash String @db.VarChar(300)

  access_level  AccountAccessLevel  @default(USER)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  tasks              tasks[]
  task_categories    task_categories[]

  user_records users[]
}


model sessions {
    id            String   @id @default(uuid())
    user_id       Int
    refresh_hash  String  
    user_agent    String?  
    ip            String?  
    last_active   DateTime @default(now()) 
    expires_at    DateTime
    created_at    DateTime @default(now())

    user app_accounts @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@index([user_id])
}